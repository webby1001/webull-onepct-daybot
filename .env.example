# Paper-only one-percent daybot (port 8082)
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
PAPER_BANKROLL=1000
PORT=8082
HOST=0.0.0.0

# Strategy: gap continuation
GAP_MIN_PCT=1.5
MAX_NOTIONAL_FRACTION=1.0
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0
FLATTEN_ET=15:55
SESSION_START_ET=09:35
SCAN_INTERVAL_MINUTES=5
MAX_DAILY_LOSS_PCT=25.0
MAX_OPEN_POSITIONS=1

